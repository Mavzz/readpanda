# =============================================================================
# ReadPanda Admin Portal — Environment Variables
# Copy this file to .env.local and fill in your values.
# =============================================================================

# --- Backend ----------------------------------------------------------------
# Production (Vercel): the API's full origin, https and no port. When set,
# VITE_BACKEND_BASE_URL and VITE_BACKEND_PORT are ignored.
# VITE_BACKEND_URL=https://readpanda-backend-439290157125.asia-south1.run.app

# Local: IP or hostname of the Go backend (without http:// or trailing slash)
VITE_BACKEND_BASE_URL=localhost
VITE_BACKEND_PORT=3000
VITE_API_VERSION=/api/v1

# --- Crypto (must match CRYPTO_SECRET in the Go backend .env.local) ---------
VITE_CRYPTO_SECRET=change_me_crypto_secret

# --- Google OAuth ------------------------------------------------------------
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
